#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
libs="$root/usr/lib/x86_64-linux-gnu"
export LD_LIBRARY_PATH="$libs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PATH="$root/usr/bin:$PATH"
export GI_TYPELIB_PATH="$libs/girepository-1.0"
export PYTHONHOME="$root/usr"
export PYTHONPATH="$root/usr/share/open-camera:$root/usr/lib/python3/dist-packages"
export XDG_DATA_DIRS="$root/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GSETTINGS_SCHEMA_DIR="$root/usr/share/glib-2.0/schemas"
export GST_PLUGIN_SYSTEM_PATH_1_0="$libs/gstreamer-1.0"
export GST_PLUGIN_SCANNER="$libs/gstreamer1.0/gstreamer-1.0/gst-plugin-scanner"
export GST_REGISTRY="${XDG_CACHE_HOME:-$HOME/.cache}/open-camera/gstreamer-appimage.bin"
export GSK_RENDERER="${GSK_RENDERER:-cairo}"
export GIO_MODULE_DIR="$libs/gio/modules"
export FONTCONFIG_FILE="$root/etc/fonts/fonts.conf"
export FONTCONFIG_PATH="$root/etc/fonts"

# The Ubuntu cache records absolute host paths. Relocate its entries for this mount.
loaders="$libs/gdk-pixbuf-2.0/2.10.0"
if [ -s "$loaders/loaders.cache" ]; then
    cache=$(mktemp)
    trap 'rm -f -- "$cache"' EXIT
    escaped_root=$(printf '%s' "$root" | sed 's/[\&|]/\\&/g')
    sed "s|\"/usr/|\"$escaped_root/usr/|g" "$loaders/loaders.cache" > "$cache"
    export GDK_PIXBUF_MODULE_FILE="$cache"
    "$root/usr/bin/python3" -m open_camera "$@"
else
    exec "$root/usr/bin/python3" -m open_camera "$@"
fi
